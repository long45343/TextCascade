# TextCascade release signing credentials template.
# Copy this file to keystore.properties (gitignored) and fill in real values.
# The keystore file must live OUTSIDE the repository, e.g. D:\EDCs\code\Android-key\textcascade-release.jks
storeFile=D:/EDCs/code/Android-key/textcascade-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=textcascade
keyPassword=YOUR_KEY_PASSWORD
